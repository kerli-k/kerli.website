{
  "TableName": "kerli-reactions",
  "AttributeDefinitions": [
    { "AttributeName": "targetId", "AttributeType": "S" },
    { "AttributeName": "clientId", "AttributeType": "S" },
    { "AttributeName": "ip", "AttributeType": "S" },
    { "AttributeName": "ts", "AttributeType": "N" }
  ],
  "KeySchema": [
    { "AttributeName": "targetId", "KeyType": "HASH" },
    { "AttributeName": "clientId", "KeyType": "RANGE" }
  ],
  "GlobalSecondaryIndexes": [
    {
      "IndexName": "ip-ts-index",
      "KeySchema": [
        { "AttributeName": "ip", "KeyType": "HASH" },
        { "AttributeName": "ts", "KeyType": "RANGE" }
      ],
      "Projection": { "ProjectionType": "ALL" }
    }
  ],
  "BillingMode": "PAY_PER_REQUEST"
}
